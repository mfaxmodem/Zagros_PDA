<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ZagrosPDA" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ZagrosPDA.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ZagrosPDA</item>
    </style>
</resources>
